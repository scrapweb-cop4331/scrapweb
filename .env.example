# Used by testing/testapi.js (see testing/run.sh, which loads this file
# via `node --env-file=../.env`).

# Base API URL, including trailing /api/ — testapi.js appends endpoint
# names directly (e.g. TEST_URL + "login").
TEST_URL=http://localhost:5000/api/

TEST_USER=testuser
TEST_PASSWORD=testpassword123
TEST_EMAIL=testuser@example.com
