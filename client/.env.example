# All frontend API calls use relative paths (e.g. /api/media) and rely on
# Vite's dev server proxy (or, in production, the reverse proxy in front of
# the built app) to forward /api/* to the backend. No browser-side env var
# is needed for this.

# Backend URL the Vite dev server proxies /api requests to.
# This is only read by vite.config.ts (Node, not the browser) and is not
# exposed to client code. Defaults to http://localhost:5000 if unset.
VITE_PROXY_TARGET=http://localhost:5000
