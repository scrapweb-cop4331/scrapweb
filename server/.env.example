# Port the Express server listens on. Defaults to 5000 if unset.
port=5000

# MongoDB connection string (mongoose.connect).
# Local Docker Compose stack: mongodb://mongo:27017/scrapweb
mongo_connection_string=mongodb://mongo:27017/scrapweb

# Secret used to sign/verify JWTs. Use a long random string in real deployments.
jwt_secret_key=dev-secret-change-me

# Host (no protocol) used to build links in verification/reset-password emails,
# e.g. scrapweb.kite-keeper.com in production, or localhost:5173 for local dev.
server_host=localhost:5173

# SendGrid API key used to send verification/reset-password emails.
sendgrid_api_key=
